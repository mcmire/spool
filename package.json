{
  "name": "spool",
  "version": "0.0.0-dev",
  "private": true,
  "bin": {
    "spool": "dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsgo --project tsconfig.build.json && cp src/commands/site/engine/client.tsx dist/commands/site/engine/client.tsx && cp src/commands/site/engine/Layout.tsx dist/commands/site/engine/Layout.tsx && cp src/commands/site/engine/spool-site.css dist/commands/site/engine/spool-site.css",
    "cli": "npm run build && node dist/cli.js",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "tsgo --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@shikijs/rehype": "^3.8.0",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "mermaid": "^11.15.0",
    "micromatch": "^4.0.8",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^6.3.5",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/micromatch": "^4.0.9",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260421.2",
    "execa": "^9.6.1",
    "oxfmt": "^0.40.0",
    "typescript": "^6.0.3",
    "vitest": "^3.1.1"
  },
  "peerDependencies": {
    "typescript": "^5 || ^6 || ^7"
  }
}
