{
  "name": "spool",
  "version": "0.0.0-dev",
  "private": true,
  "bin": {
    "spool": "dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json && cp -r src/commands/site/engine dist/commands/site/engine",
