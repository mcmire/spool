    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "micromatch": "^4.0.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "vite": "^6.3.5",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/micromatch": "^4.0.9",
    "@types/node": "^25.5.0",
